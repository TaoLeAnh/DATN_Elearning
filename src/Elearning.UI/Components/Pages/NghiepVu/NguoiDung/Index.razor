@page "/nghiep-vu/quan-ly-nguoi-dung"
@using Elearning.Shared.Commons.Enums
@using Elearning.Shared.Commons.Extensions
@using Elearning.Shared.Contracts.Portal.Dtos
@using Elearning.UI.Shared
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons;

<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
    <h2>Danh sách Người Dùng</h2>

    <FluentStack Orientation="Orientation.Horizontal" Style="display:flex; justify-content:space-between">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10">
            <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.AddCircle())" Title="Thêm mới" OnClick="OpenAddModal" Loading="@IsLoadingSync">Thêm mới</FluentButton>
        </FluentStack>

        <FluentSearch style="width:300px" Placeholder="Nhập tên người dùng..." @bind-Value="@SearchKeyword" @bind-Value:after=HandleSearchChanged />
    </FluentStack>

    <FluentDataGrid ShowHover="true" 
                    @ref="Grid" 
                    TGridItem="NguoiDungDto" 
                    ItemsProvider="LoadDatas" 
                    GridTemplateColumns="1fr 3fr 3fr 2fr 2fr" 
                    RowSize="DataGridRowSize.Large" 
                    Style="width:100%;" 
                    Pagination="@pagination">

        <TemplateColumn Title="#" Sortable="false">
            @context.STT
        </TemplateColumn>

        <TemplateColumn Title="Họ và tên" Sortable="true" SortBy="@_roleTenSort">
            <span @onclick="@(() => OpenDetailsModal(context.Id))" style="cursor: pointer; color: dodgerblue; font-weight: 500;">
                @context.Ten
            </span>
        </TemplateColumn>

        <TemplateColumn Title="Email" Sortable="false">
            @context.Email
        </TemplateColumn>

        <TemplateColumn Title="Vai trò" Sortable="false">
            @context.VaiTro.GetDescription()
        </TemplateColumn>

        <TemplateColumn Title="Thao tác" Style="display: flex; justify-content: flex-end;">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5">
                <FluentButton Loading="@IsLoadingSync" Appearance="Appearance.Outline" Title="Chỉnh sửa" OnClick="@(() => EditAction(context.Id))">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" />
                </FluentButton>

                <FluentButton Title="Xóa" Appearance="Appearance.Outline" OnClick="()=>OpenModalDelete(context.Id)">
                   <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" />
               </FluentButton>
            </FluentStack>
        </TemplateColumn>
    </FluentDataGrid>
    <Paginator PaginationState="@pagination" SelectedPageSizeChanged="RefreshData" />
</FluentStack>

