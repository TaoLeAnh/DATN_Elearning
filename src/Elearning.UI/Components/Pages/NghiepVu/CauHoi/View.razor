@using Elearning.Shared.Commons.Interfaces.Extentions
@using Elearning.Shared.Commons.Model.ServiceCustomHttpClient
@using Elearning.Shared.Contracts.Portal.Dtos
@using Elearning.Shared.Contracts.Portal.Enums
@using Elearning.UI.Application.Dtos
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons;
@using Elearning.Shared.Commons.Extensions

@implements IDialogContentComponent<EditOrUpdateParametersDto>

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.Eye())" />
        <FluentLabel Typo="Typography.PaneHeader">Xem trước Câu hỏi</FluentLabel>
    </FluentStack>
</FluentDialogHeader>

<FluentDialogBody>
    @if (!IsLoading)
    {
        <div style="background-color: #f9f9f9; padding: 20px; border-radius: 8px;">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" Style="margin-bottom:10px;">
                @* Ép kiểu Enum an toàn *@
                <FluentBadge Appearance="Appearance.Neutral">@(((EnumLoaiCauHoi)Item.LoaiCauHoi).GetDescription() ?? "Chưa xác định")</FluentBadge>
                <FluentBadge Appearance="Appearance.Accent">@(((EnumMucDo)Item.MucDo).GetDescription() ?? "Chưa xác định")</FluentBadge>

                @if (Item.MonHoc.HasValue)
                {
                    <FluentBadge Fill="success" Color="white">Môn: @(((MonHocEnum)Item.MonHoc.Value).GetDescription())</FluentBadge>
                }

                <span style="color: gray; font-size: 0.9em; margin-left: 5px;">Chủ đề: @Item.ChuDe</span>
            </FluentStack>

            <h3 style="margin-top: 10px;">
                @if (!string.IsNullOrEmpty(Item.NoiDung))
                {
                    <div style="margin-bottom: 10px;">@((MarkupString)Item.NoiDung)</div>
                }
                @if (!string.IsNullOrEmpty(Item.HinhAnhUrl))
                {
                    <img src="@Item.HinhAnhUrl" style="max-width: 100%; border-radius: 8px;" />
                }
            </h3>

            <div style="margin-top: 20px;">
                @for (int i = 0; i < Item.DapAns.Count; i++)
                {
                    var ans = Item.DapAns[i];
                    <div style="padding: 10px; margin-bottom: 8px; border-radius: 6px; border: 1px solid @(ans.LaDapAnDung ? "green" : "#e0e0e0"); background-color: @(ans.LaDapAnDung ? "#e6ffe6" : "white"); display: flex; align-items: center;">
                        <strong style="margin-right: 15px; width: 25px;">@((char)('A' + i)).</strong>

                        @if (!string.IsNullOrEmpty(ans.HinhAnhUrl))
                        {
                            <img src="@ans.HinhAnhUrl" style="max-height: 50px; border-radius: 4px;" />
                        }
                        else
                        {
                            @* Dùng MarkupString để render HTML của đáp án *@
                            <div style="margin: 0; padding: 0;">@((MarkupString)ans.NoiDung)</div>
                        }

                        @if (ans.LaDapAnDung)
                        {
                            <div style="margin-left: auto; color: green;"><FluentIcon Value="@(new Icons.Regular.Size20.CheckmarkCircle())" /></div>
                        }
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Item.GiaiThich))
            {
                <div style="margin-top: 20px; padding: 15px; border-left: 4px solid #0078d4; background-color: #f3f2f1;">
                    <strong>Lời giải thích:</strong><br />
                    @* Dùng MarkupString để render HTML của giải thích *@
                    @((MarkupString)Item.GiaiThich)
                </div>
            }
        </div>
    }
    else
    {
        <FluentProgressRing />
    }
</FluentDialogBody>

<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Neutral" OnClick="() => Dialog.CancelAsync()">Đóng</FluentButton>
</FluentDialogFooter>

@code {
    [CascadingParameter] public FluentDialog Dialog { get; set; } = default!;
    [Parameter] public EditOrUpdateParametersDto Content { get; set; } = new();
    [Inject] private ICallServiceRegistry CallService { get; set; } = default!;

    private CauHoiDto Item = new();
    private bool IsLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstLoad)
    {
        if (firstLoad)
        {
            var req = new ApiRequestModel
            {
                ApiService = ServicesRegistryEnum.ServicePortal,
                Endpoint = $"/CauHoi/{Content.Id}",
                HasAuthorization = true
            };

            var res = await CallService.Get<CauHoiDto>(req);

            if (res.Status == StatusCode.OK && res.Data != null)
            {
                Item = res.Data;
            }

            IsLoading = false;
            StateHasChanged();
        }
    }
}