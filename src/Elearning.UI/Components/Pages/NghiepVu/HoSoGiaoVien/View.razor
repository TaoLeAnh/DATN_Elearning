@using Elearning.Shared.Commons.Interfaces.Extentions
@using Elearning.Shared.Commons.Model.ServiceCustomHttpClient
@using Elearning.Shared.Contracts.Portal.Dtos
@using Elearning.UI.Application.Dtos
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons;
@using Elearning.Shared.Commons.Extensions

@implements IDialogContentComponent<EditOrUpdateParametersDto>

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.Info())" />
        <FluentLabel Typo="Typography.PaneHeader">Chi tiết Hồ sơ Giáo viên</FluentLabel>
    </FluentStack>
</FluentDialogHeader>

<FluentDialogBody>
    @if (!IsLoading)
    {
        <FluentGrid Spacing="3">
            <FluentGridItem md="12" Style="text-align: center;">
                @if (!string.IsNullOrEmpty(Item.AnhDaiDienUrl))
                {
                    <img src="@Item.AnhDaiDienUrl" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 2px solid #1e73be;" />
                }
                else
                {
                    <div style="width: 120px; height: 120px; border-radius: 50%; background: #eee; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                        <FluentIcon Value="@(new Icons.Regular.Size48.Person())" />
                    </div>
                }
            </FluentGridItem>

            <FluentGridItem md="6"><b>Giáo viên:</b> <div>@Item.TenGiaoVien</div></FluentGridItem>
            <FluentGridItem md="6"><b>Chuyên môn:</b> <div>@Item.MonHocChuyenMon.GetDescription()</div></FluentGridItem>

            <FluentGridItem md="12">
                <b>Thành tích nổi bật:</b>
                <div style="border: 1px solid #eee; padding: 10px; white-space: pre-line; background-color: #fafafa; border-radius: 4px;">
                    @(string.IsNullOrEmpty(Item.ThanhTichNoiBat) ? "Đang cập nhật..." : Item.ThanhTichNoiBat)
                </div>
            </FluentGridItem>

            <FluentGridItem md="12">
                <b>Phương pháp giảng dạy:</b>
                <div style="border: 1px solid #eee; padding: 10px; white-space: pre-line; background-color: #fafafa; border-radius: 4px;">
                    @(string.IsNullOrEmpty(Item.PhuongPhapGiangDay) ? "Đang cập nhật..." : Item.PhuongPhapGiangDay)
                </div>
            </FluentGridItem>
        </FluentGrid>
    }
    else
    {
        <FluentProgressRing />
    }
</FluentDialogBody>

<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Neutral" OnClick="() => Dialog.CancelAsync()">Đóng</FluentButton>
</FluentDialogFooter>

@code {
    [CascadingParameter] public FluentDialog Dialog { get; set; } = default!;
    [Parameter] public EditOrUpdateParametersDto Content { get; set; } = new();
    [Inject] private ICallServiceRegistry CallService { get; set; } = default!;
    private HoSoGiaoVienDto Item = new();
    private bool IsLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstLoad)
    {
        if (firstLoad)
        {
            var req = new ApiRequestModel
            {
                ApiService = ServicesRegistryEnum.ServicePortal,
                Endpoint = $"/HoSoGiaoVien/{Content.Id}",
                HasAuthorization = true
            };

            var res = await CallService.Get<HoSoGiaoVienDto>(req);

            if (res.Status == StatusCode.OK && res.Data != null)
            {
                Item = res.Data;
            }

            IsLoading = false;
            StateHasChanged();
        }
    }
}