@using Elearning.Shared.Commons.Interfaces.Extentions
@using Elearning.Shared.Commons.Model.ServiceCustomHttpClient
@using Elearning.Shared.Contracts.Portal.Dtos
@using Elearning.UI.Application.Dtos
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons;
@using Elearning.Shared.Commons.Extensions
@implements IDialogContentComponent<EditOrUpdateParametersDto>

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.Info())" />
        <FluentLabel Typo="Typography.PaneHeader">Chi tiết Đăng ký Khóa học</FluentLabel>
    </FluentStack>
</FluentDialogHeader>

<FluentDialogBody>
    @if (!IsLoading)
    {
        <FluentGrid Spacing="3">
            <FluentGridItem md="6"><b>Học viên:</b> <div>@Item.TenNguoiDung</div></FluentGridItem>
            <FluentGridItem md="6"><b>Email:</b> <div>@Item.EmailNguoiDung</div></FluentGridItem>
            <FluentGridItem md="12"><b>Khóa học:</b> <div>@Item.TenKhoaHoc</div></FluentGridItem>
            <FluentGridItem md="6"><b>Trạng thái:</b> <div><FluentBadge Appearance="Appearance.Neutral">@Item.TrangThai.GetDescription()</FluentBadge></div></FluentGridItem>
            <FluentGridItem md="6"><b>Tiến độ:</b> <div>@Item.TienDo %</div></FluentGridItem>
            <FluentGridItem md="6"><b>Ngày đăng ký:</b> <div>@Item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</div></FluentGridItem>
        </FluentGrid>
    }
    else
    {

        <FluentProgressRing />
    }
</FluentDialogBody>

<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Neutral" OnClick="() => Dialog.CancelAsync()">Đóng</FluentButton>
</FluentDialogFooter>

@code {
    [CascadingParameter] public FluentDialog Dialog { get; set; } = default!;
    [Parameter] public EditOrUpdateParametersDto Content { get; set; } = new();
    [Inject] private ICallServiceRegistry CallService { get; set; } = default!;
    private DangKyKhoaHocDto Item = new();
    private bool IsLoading = true;

    // protected override async Task OnAfterRenderAsync(bool firstLoad)
    // {
    //     if (firstLoad)
    //     {
    //         var res = await CallService.Get<DangKyKhoaHocDto>(new ApiRequestModel 
    //             { Endpoint = $"/DangKyKhoaHoc/{Content.Id}", HasAuthorization = true });
    //         if (res.Status == StatusCode.OK && res.Data != null) Item = res.Data;
    //         IsLoading = false; StateHasChanged();
    //     }
    // }
    protected override async Task OnAfterRenderAsync(bool firstLoad)
    {
        if (firstLoad)
        {
            var req = new ApiRequestModel
            {
                ApiService = ServicesRegistryEnum.ServicePortal,
                Endpoint = $"/DangKyKhoaHoc/{Content.Id}",
                HasAuthorization = true
            };
            var res = await CallService.Get<DangKyKhoaHocDto>(req);
            if (res.Status == StatusCode.OK && res.Data != null) Item = res.Data;
            IsLoading = false;
            StateHasChanged();
        }
    }
}