@using Elearning.Shared.Commons.Interfaces.Extentions
@using Elearning.Shared.Commons.Model.Commons.Service.Shared.Commons.Model.Commons
@using Elearning.Shared.Commons.Model.ServiceCustomHttpClient
@using Elearning.Shared.Contracts.Portal.Dtos
@using Elearning.Shared.Contracts.Portal.Forms
@using Elearning.Shared.Contracts.Portal.Enums
@using Elearning.UI.Application.Dtos
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons;
@implements IDialogContentComponent<EditOrUpdateParametersDto>

@if (!IsLoading)
{
    <FluentDialogHeader ShowDismiss="true">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Icons.Regular.Size24.Edit())" />
            <FluentLabel Typo="Typography.PaneHeader">@Dialog.Instance.Parameters.Title</FluentLabel>
        </FluentStack>
    </FluentDialogHeader>

    <FluentDialogBody>
        <EditForm Model="@ModelForm" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <FluentGrid Spacing="2" Style="padding:4px;">

                <FluentGridItem md="12">
                    <FluentAutocomplete TOption="LookupOption" Label="Học viên (*)"
                                        OnOptionsSearch="OnSearchNguoiDung" OptionText="@(i => i.Name)"
                                        @bind-SelectedOptions="SelectedNguoiDungs" MaximumSelectedOptions="1"
                                        Placeholder="Gõ tên học viên..." Style="width: 100%;"
                                        Disabled="@Content.IsEditMode" />
                    <ValidationMessage For="@(() => ModelForm.NguoiDungId)" Style="color:red;" />
                </FluentGridItem>

                <FluentGridItem md="12">
                    <FluentAutocomplete TOption="LookupOption" Label="Khóa học (*)"
                                        OnOptionsSearch="OnSearchKhoaHoc" OptionText="@(i => i.Name)"
                                        @bind-SelectedOptions="SelectedKhoaHocs" MaximumSelectedOptions="1"
                                        Placeholder="Gõ tên khóa học..." Style="width: 100%;"
                                        Disabled="@Content.IsEditMode" />
                    <ValidationMessage For="@(() => ModelForm.KhoaHocId)" Style="color:red;" />
                </FluentGridItem>

                <FluentGridItem md="6">
                    <FluentSelect Label="Trạng thái" TOption="string" Value="@ModelForm.TrangThai.ToString()"
                                  ValueChanged="@(v => ModelForm.TrangThai = Enum.Parse<EnumTrangThaiDangKy>(v))" Style="width: 100%;">
                        @foreach (var item in Enum.GetValues<EnumTrangThaiDangKy>())
                        {
                            <FluentOption Value="@item.ToString()">@item.ToString()</FluentOption>
                        }
                    </FluentSelect>
                </FluentGridItem>

                <FluentGridItem md="6">
                    <FluentNumberField @bind-Value="ModelForm.TienDo" Label="Tiến độ (%)" Style="width: 100%;" />
                </FluentGridItem>

            </FluentGrid>

            <FluentDialogFooter>
                <FluentButton Appearance="Appearance.Neutral" OnClick="CancelAsync" Disabled="@IsSaving">Hủy</FluentButton>
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Loading="@IsSaving">Lưu</FluentButton>
            </FluentDialogFooter>
        </EditForm>
    </FluentDialogBody>
}
else
{
    <FluentDialogBody><FluentProgressRing /></FluentDialogBody>
}

@code {
    [CascadingParameter] public FluentDialog Dialog { get; set; } = default!;
    [Parameter] public EditOrUpdateParametersDto Content { get; set; } = new();
    [Inject] private ICallServiceRegistry CallService { get; set; } = default!;
    [Inject] private IToastService ToastService { get; set; } = default!;

    private bool IsLoading = true;
    private bool IsSaving = false;
    private DangKyKhoaHocForm ModelForm = new();

    public class LookupOption { public Guid Id { get; set; } public string Name { get; set; } = ""; }

    private IEnumerable<LookupOption> _selectedNguoiDungs = new List<LookupOption>();
    private IEnumerable<LookupOption> SelectedNguoiDungs { get => _selectedNguoiDungs; set { _selectedNguoiDungs = value; ModelForm.NguoiDungId = _selectedNguoiDungs.FirstOrDefault()?.Id ?? Guid.Empty; } }

    private IEnumerable<LookupOption> _selectedKhoaHocs = new List<LookupOption>();
    private IEnumerable<LookupOption> SelectedKhoaHocs { get => _selectedKhoaHocs; set { _selectedKhoaHocs = value; ModelForm.KhoaHocId = _selectedKhoaHocs.FirstOrDefault()?.Id ?? Guid.Empty; } }

    protected override async Task OnAfterRenderAsync(bool firstLoad)
    {
        if (firstLoad)
        {
            if (Content.IsEditMode)
            {
                var req = new ApiRequestModel { ApiService = ServicesRegistryEnum.ServicePortal, Endpoint = $"/DangKyKhoaHoc/{Content.Id}", HasAuthorization = true };
                var res = await CallService.Get<DangKyKhoaHocDto>(req);
                if (res.Status == StatusCode.OK && res.Data != null)
                {
                    ModelForm = new DangKyKhoaHocForm { NguoiDungId = res.Data.NguoiDungId, KhoaHocId = res.Data.KhoaHocId, TrangThai = res.Data.TrangThai, TienDo = res.Data.TienDo };

                    if (ModelForm.NguoiDungId != Guid.Empty)
                    {
                        var resND = await CallService.Get<NguoiDungDto>(new ApiRequestModel { Endpoint = $"/NguoiDung/{ModelForm.NguoiDungId}", HasAuthorization = true });
                        if (resND.Data != null) _selectedNguoiDungs = new List<LookupOption> { new LookupOption { Id = resND.Data.Id, Name = resND.Data.Ten } };
                    }
                    if (ModelForm.KhoaHocId != Guid.Empty)
                    {
                        var resKH = await CallService.Get<KhoaHocDto>(new ApiRequestModel { Endpoint = $"/KhoaHoc/{ModelForm.KhoaHocId}", HasAuthorization = true });
                        if (resKH.Data != null) _selectedKhoaHocs = new List<LookupOption> { new LookupOption { Id = resKH.Data.Id, Name = resKH.Data.TenKhoaHoc } };
                    }
                }
            }
            IsLoading = false; StateHasChanged();
        }
    }

    private async Task OnSearchNguoiDung(OptionsSearchEventArgs<LookupOption> e)
    {
        var res = await CallService.Post<DataTableJson<NguoiDungDto>>(new ApiRequestModel { Endpoint = "/NguoiDung/getpaged", HasAuthorization = true }, new { SearchText = e.Text, PageIndex = 1, PageSize = 20 });
        if (res.Status == StatusCode.OK && res.Data?.Data != null) e.Items = res.Data.Data.Select(x => new LookupOption { Id = x.Id, Name = x.Ten }).ToList();
    }

    private async Task OnSearchKhoaHoc(OptionsSearchEventArgs<LookupOption> e)
    {
        var res = await CallService.Post<DataTableJson<KhoaHocDto>>(new ApiRequestModel { Endpoint = "/KhoaHoc/getpaged", HasAuthorization = true }, new { SearchText = e.Text, PageIndex = 1, PageSize = 20 });
        if (res.Status == StatusCode.OK && res.Data?.Data != null) e.Items = res.Data.Data.Select(x => new LookupOption { Id = x.Id, Name = x.TenKhoaHoc }).ToList();
    }

    private async Task Save()
    {
        if (ModelForm.NguoiDungId == Guid.Empty || ModelForm.KhoaHocId == Guid.Empty)
        {
            ToastService.ShowWarning("Vui lòng chọn học viên và khóa học.");
            return;
        }

        IsSaving = true;
        try
        {
            var req = new ApiRequestModel
            {
                ApiService = ServicesRegistryEnum.ServicePortal,
                Endpoint = Content.IsEditMode ? $"/DangKyKhoaHoc/{Content.Id}" : "/DangKyKhoaHoc",
                HasAuthorization = true
            };

            bool isSuccess = false;
            string? errorMessage = string.Empty;

            if (Content.IsEditMode)
            {
                var result = await CallService.Put(req, ModelForm);
                isSuccess = result.Status == StatusCode.OK;
                errorMessage = result.Message;
            }
            else
            {
                var result = await CallService.Post<Guid>(req, ModelForm);
                isSuccess = result.Status == StatusCode.OK;
                errorMessage = result.Message;
            }

            if (isSuccess)
            {
                ToastService.ShowSuccess("Lưu thành công!");
                await Dialog.CloseAsync();
                await Content.OnRefresh.InvokeAsync();
            }
            else
            {
                ToastService.ShowError(errorMessage ?? "Lỗi khi lưu");
            }
        }
        finally
        {
            IsSaving = false;
        }
    }
    private async Task CancelAsync() => await Dialog.CancelAsync();
}