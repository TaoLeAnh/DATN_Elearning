@using System.IdentityModel.Tokens.Jwt
@using Elearning.Shared.Commons.Model.Commons
@using Elearning.UI.Application
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.FluentUI.AspNetCore.Components

@inherits LayoutComponentBase
@inject IWebHostEnvironment Env

<div>
    @if (IsLoading)
    {
        <style>
            .splash-screen {
                position: fixed;
                inset: 0;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                background: #fff;
                z-index: 9999;
            }

            .splash-logo {
                width: auto;
                margin: 30px 0 0 0;
            }

            .progress-text {
                margin-top: 8px;
                font-family: "Segoe UI", sans-serif;
                font-size: 1.1rem;
                font-weight: 600;
                color: #444;
            }
        </style>
        <div class="splash-screen">
            <div class="splash-logo">
                <svg width="260" height="140" viewBox="0 0 260 140" xmlns="http://www.w3.org/2000/svg" aria-label="Splash - Lưu trữ điện tử">
                    <style>
                        .s {
                            stroke: #0ea5e9;
                            stroke-width: 4;
                            stroke-linecap: round;
                            stroke-linejoin: round;
                            fill: none
                        }

                        .f {
                            fill: #0ea5e9
                        }
                    </style>
                    <rect x="20" y="40" width="100" height="70" rx="8" class="s" />
                    <path d="M20 40h100v16H20z" class="s" />
                    <rect x="62" y="64" width="16" height="10" rx="3" class="s" />
                    <rect x="46" y="86" width="48" height="16" rx="3" class="s" />
                    <path d="M52 94h4m4 0h2m4 0h6m4 0h2m4 0h4m74-64h48l22 22v58h-70z" class="s" />
                    <path d="M208 30v22h22m-60 4h48m-48 10h42m-42 12h50m-50 12h46m14-40h10m-10 30h10" class="s" />
                    <circle cx="246" cy="50" r="4" class="f" />
                    <circle cx="246" cy="80" r="4" class="f" />
                </svg>
            </div>
            <FluentProgress Min="0" Max="100" Value="@Progress" Style="--stroke-width:4; width:200px; margin-top:16px;" />
            <div class="progress-text">@Progress%</div>
        </div>
    }
    else
    {
        <CascadingValue Value="CurrentUser">
            <FluentLayout>
                <FluentHeader Class="siteheader">
                    <Header />
                </FluentHeader>
                <FluentStack Class="body-stack" Orientation="Orientation.Horizontal"
                             Width="100%" HorizontalGap="0">

                    <div style="width: 350px; height: 100%; border-right: 1px solid #e0e0e0;">
                        <NavMenu />
                    </div>

                    <FluentBodyContent id="body-content" Style="height: calc(100dvh - 90px);">
                        <div class="content">
                            <article id="article" style="padding: 20px;">
                                @Body
                            </article>
                            <FluentToastProvider MaxToastCount="10" Position="ToastPosition.TopRight" />
                            <FluentDialogProvider />
                            <FluentTooltipProvider />
                            <FluentKeyCodeProvider />
                            <FluentMenuProvider />
                        </div>
                    </FluentBodyContent>
                </FluentStack>
                <FluentFooter> 
                    <Footer />
                </FluentFooter>
            </FluentLayout>
        </CascadingValue>
    }
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool IsLoading = true;
    private int Progress;

    // 1. Khai báo CurrentUser mặc định (rỗng)
    private CurrentUserDto CurrentUser = new();

    // 2. Inject IUserService để lấy thông tin người dùng thực
    [Inject] private IUserService UserService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // 3. Lấy thông tin user thật trước khi loading xong
        try
        {
            var user = await UserService.GetCurrentUserAsync();
            if (user != null)
            {
                CurrentUser = user;
            }
        }
        catch
        {
            // Bỏ qua lỗi nếu có (để hệ thống không sập nếu rớt mạng)
        }

        // Đoạn loading UI giữ nguyên
        var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(50));

        while (Progress < 100 && await timer.WaitForNextTickAsync())
        {
            Progress += 20;
            StateHasChanged();
        }

        await Task.Delay(150);
        IsLoading = false;
        StateHasChanged();
    }
}