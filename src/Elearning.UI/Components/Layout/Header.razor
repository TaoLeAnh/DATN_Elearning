@* <FluentDivider Role="DividerRole.Presentation" Orientation="Orientation.Vertical"></FluentDivider> *@


<div class="notifications">
    <NotificationCenter />
</div>
<div class="settings">
    <SiteSettings />
</div>
<div class="User" style="margin-right:10px">
    <FluentStack HorizontalAlignment="@HorizontalAlignment.End"
                 VerticalAlignment="@VerticalAlignment.Center"
                 Style="height: 48px; background: var(--neutral-layer-4); padding-inline-end: 10px; ">

        @* SỬA Ở ĐÂY: Hiển thị FullName thay vì UserName *@
        <FluentProfileMenu HeaderButton="Đăng xuất"
                           OnHeaderButtonClick="@LogoutAction"
                           FullName="@(string.IsNullOrEmpty(CurrentUser.FullName) ? CurrentUser.UserName : CurrentUser.FullName)"
                           EMail="@CurrentUser.Email"
                           PopoverStyle="min-width: 330px;">

            <FooterTemplate>
                <FluentStack>
                    <FluentSpacer />
                    <FluentAnchor Appearance="@Appearance.Hypertext" Href="#"
                                  OnClick="@(() => OpenUserDialog(CurrentUser.UserId))">
                        Xem tài khoản
                    </FluentAnchor>
                </FluentStack>
            </FooterTemplate>
        </FluentProfileMenu>
    </FluentStack>
</div>

@code {

    [Inject] IDialogService DialogService { get; set; } = default!;
    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    [CascadingParameter]
    protected CurrentUserDto CurrentUser { set; get; } = new();



    private async Task OpenUserDialog(Guid Id)
    {
        try
        {


            var dialog = await DialogService.ShowDialogAsync<InfoUser>(Id, new DialogParameters()
            {
                Title = "Thông tin người dùng",
                PreventDismissOnOverlayClick = true,
                PreventScroll = true,
                Modal = true,

            });


        }
        catch (Exception ex)
        {
            var dialog = await DialogService.ShowErrorAsync(ex.Message);
        }
    }

    private async Task LogoutAction()
    {
        try
        {
            NavigationManager.NavigateTo("account/logout", true);
        }
        catch (Exception ex)
        {
            var dialog = await DialogService.ShowErrorAsync(ex.Message);
        }
    }
}
