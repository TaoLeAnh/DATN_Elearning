@page "/ky-thi-cua-toi"
@model KyThiCuaToiModel
@using System.ComponentModel
@using System.Reflection
@using Elearning.Shared.Contracts.Portal.Enums
@{
    ViewData["Title"] = "Kỳ thi của tôi";

    string GetEnumDescription(Enum value)
    {
        FieldInfo fi = value.GetType().GetField(value.ToString());
        DescriptionAttribute[] attributes = (DescriptionAttribute[])fi.GetCustomAttributes(typeof(DescriptionAttribute), false);
        return attributes != null && attributes.Length > 0 ? attributes[0].Description : value.ToString();
    }

    string GetIcon(MonHocEnum m) => m switch
    {
        MonHocEnum.Toan => "🧮",
        MonHocEnum.NguVan => "📖",
        MonHocEnum.TiengAnh => "✍️",
        MonHocEnum.VatLy => "⚡",
        MonHocEnum.HoaHoc => "🧪",
        MonHocEnum.SinhHoc => "🧬",
        MonHocEnum.LichSu => "⏳",
        MonHocEnum.DiaLy => "🌍",
        MonHocEnum.GDCD => "🤝",
        MonHocEnum.KhoaHocVaDocHieu => "🔬",
        _ => "📚"
    };
}

<style>
    .subject-menu {
        display: flex;
        flex-direction: column;
        gap: 12px;
        position: sticky;
        top: 100px;
    }

    .subject-item {
        display: flex;
        align-items: center;
        padding: 12px 20px;
        background-color: #fcfcfc;
        border: 1.5px solid #eaeaea;
        border-radius: 14px;
        cursor: pointer;
        transition: all 0.2s ease;
        color: #1a365d;
        font-weight: 700;
    }

        .subject-item:hover, .subject-item.active {
            border-color: #0d6efd;
            background-color: #f0f7ff;
            color: #0d6efd;
        }

    .subject-icon {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #fff;
        border-radius: 10px;
        margin-right: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        font-size: 1.2rem;
    }

    .my-course-card {
        transition: all 0.3s ease;
        border: none;
        border-radius: 12px;
        overflow: hidden;
    }

        .my-course-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .course-img-wrapper {
        height: 160px;
        position: relative;
        background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-continue {
        background: linear-gradient(135deg, #0072bc 0%, #28b1ff 100%);
        border: none;
        color: white;
    }
</style>

<div class="container mt-5 mb-5" style="min-height: 70vh;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa-solid fa-file-signature text-info me-2"></i> Lịch sử thi của tôi</h2>

        <div class="d-flex gap-3">
            <div class="input-group shadow-sm" style="width: 250px; border-radius: 8px; overflow: hidden;">
                <span class="input-group-text bg-white border-0"><i class="fa-solid fa-search text-muted"></i></span>
                <input type="text" id="examSearch" class="form-control border-0 border-start" placeholder="Tìm tên bài thi..." style="box-shadow: none;">
            </div>
        </div>
    </div>

    @if (Model.LstMyExams != null && Model.LstMyExams.Any())
    {
        <div class="row g-4">
            <div class="col-lg-3">
                <div class="subject-menu custom-scrollbar" style="max-height: 70vh; overflow-y: auto;">
                    <div class="subject-item active" data-subject-value="all">
                        <div class="subject-icon"><i class="fa-solid fa-border-all"></i></div>
                        Tất cả môn học
                    </div>
                    @foreach (MonHocEnum mon in Enum.GetValues(typeof(MonHocEnum)))
                    {
                        <div class="subject-item" data-subject-value="@mon.ToString()">
                            <div class="subject-icon">@GetIcon(mon)</div>
                            @GetEnumDescription(mon)
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-9">
                <div class="row g-4" id="examListContainer">
                    @foreach (var item in Model.LstMyExams)
                    {
                        <div class="col-md-4 exam-item" data-subject="@item.MonHoc">
                            <div class="card h-100 my-course-card shadow-sm border border-light">
                                <div class="course-img-wrapper">
                                    <i class="fa-solid fa-award" style="font-size: 4rem; color: #f6ad55;"></i>
                                    <span class="badge bg-success position-absolute top-0 end-0 m-2">Đã chấm điểm</span>
                                </div>

                                <div class="card-body d-flex flex-column">
                                    <h6 class="fw-bold mb-1 course-title-text" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 45px;">
                                        @item.TenKyThi
                                    </h6>
                                    <p class="text-muted small mb-3"><i class="fa-regular fa-calendar me-1"></i> Thi lúc: @item.ThoiDiemBatDau.ToString("dd/MM/yyyy HH:mm")</p>

                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="small text-muted fw-bold">Điểm số:</span>
                                            <span class="fw-bold" style="font-size: 1.5rem; color: #e53e3e;">@item.Diem.ToString("0.##") <small class="text-muted" style="font-size: 0.9rem;">/10</small></span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-3 small">
                                            <span class="text-muted">Câu đúng:</span>
                                            <span class="fw-bold text-success">@item.SoCauDung <span class="text-muted fw-normal">/ @item.TongSoCau</span></span>
                                        </div>
                                        <a href="/ky-thi-cua-toi/review/@item.Id" class="btn btn-continue w-100 fw-bold rounded-pill">
                                            XEM LẠI BÀI LÀM
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div id="noResultMsg" class="text-center py-5" style="display: none;">
                    <i class="fa-solid fa-ghost fa-3x text-muted opacity-50 mb-3"></i>
                    <h5 class="text-muted">Không tìm thấy bài thi nào phù hợp.</h5>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" style="width: 150px; opacity: 0.5;" />
            <h4 class="mt-4 text-muted">Bạn chưa có kết quả thi nào</h4>
            <p class="text-muted">Các bài thi sau khi được giảng viên duyệt điểm sẽ xuất hiện tại đây.</p>
            <a href="/Exam" class="btn btn-primary mt-3 px-4 rounded-pill">Vào phòng thi ngay</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('examSearch');
            const examItems = document.querySelectorAll('.exam-item');
            const subjectItems = document.querySelectorAll('.subject-item');
            const noResultMsg = document.getElementById('noResultMsg');

            let currentSubjectFilter = 'all';

            function applyFilters() {
                const searchValue = searchInput ? searchInput.value.toLowerCase().trim() : '';
                let visibleCount = 0;

                examItems.forEach(item => {
                    const examSubject = item.getAttribute('data-subject');
                    const examName = item.querySelector('.course-title-text').innerText.toLowerCase();

                    let matchSearch = examName.includes(searchValue);
                    let matchSubject = (currentSubjectFilter === 'all' || currentSubjectFilter === examSubject);

                    if (matchSearch && matchSubject) {
                        item.style.display = 'block';
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                if(noResultMsg) noResultMsg.style.display = visibleCount === 0 ? 'block' : 'none';
            }

            subjectItems.forEach(item => {
                item.addEventListener('click', function () {
                    subjectItems.forEach(i => i.classList.remove('active'));
                    this.classList.add('active');
                    currentSubjectFilter = this.getAttribute('data-subject-value');
                    applyFilters();
                });
            });

            if (searchInput) searchInput.addEventListener('keyup', applyFilters);
        });
    </script>
}