@page "/ky-thi-cua-toi/review/{BaiLamId:guid}"
@model Elearning.Publising.UI.Pages.ReviewBaiThiModel
@using Elearning.Shared.Contracts.Portal.Enums
@{
    ViewData["Title"] = "Chi tiết bài làm";
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb" class="mb-4 small">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang Chủ</a></li>
            <li class="breadcrumb-item"><a href="/ky-thi-cua-toi">Kỳ thi của tôi</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết bài làm</li>
        </ol>
    </nav>

    @if (Model.ReviewData == null)
    {
        <div class="alert alert-danger text-center">Không tìm thấy dữ liệu bài thi hoặc bạn không có quyền xem!</div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px;">
                    <div class="card-body p-4 text-center">
                        <i class="fa-solid fa-clipboard-check text-success mb-3" style="font-size: 4rem;"></i>
                        <h5 class="fw-bold text-primary mb-1">@Model.ReviewData.TenKyThi</h5>
                        <p class="text-muted small mb-4">Môn: @Model.ReviewData.MonHoc</p>

                        <div class="p-3 bg-light rounded-3 mb-4 border border-2 @(Model.ReviewData.Diem >= 5 ? "border-success" : "border-danger")">
                            <div class="text-muted mb-1">Điểm số đạt được</div>
                            <div class="fw-bold" style="font-size: 3rem; color: @(Model.ReviewData.Diem >= 5 ? "#198754" : "#dc3545"); line-height: 1;">
                                @Model.ReviewData.Diem.ToString("0.##")<span class="fs-4 text-dark">/10</span>
                            </div>
                        </div>

                        <ul class="list-group list-group-flush text-start mb-0">
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Học viên:</span>
                                <b>@Model.ReviewData.TenSinhVien</b>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Số câu đúng:</span>
                                <b class="text-success">@Model.ReviewData.SoCauDung / @Model.ReviewData.TongSoCau</b>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Nộp bài lúc:</span>
                                <b>@(Model.ReviewData.ThoiDiemNop?.ToString("dd/MM/yyyy HH:mm") ?? "-")</b>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h4 class="fw-bold border-bottom pb-3 mb-4">Chi tiết đáp án</h4>

                        @foreach (var cauHoi in Model.ReviewData.DanhSachCauHoi.OrderBy(x => x.PhanThi).ThenBy(x => x.ThuTu))
                        {
                            <div class="mb-5 p-4 rounded-3 border @(cauHoi.IsCorrect ? "border-success bg-success bg-opacity-10" : "border-danger bg-danger bg-opacity-10")">
                                <div class="d-flex justify-content-between mb-3">
                                    <h6 class="fw-bold m-0 @(cauHoi.IsCorrect ? "text-success" : "text-danger")">
                                        <i class="fa-solid @(cauHoi.IsCorrect ? "fa-check-circle" : "fa-times-circle") me-2"></i>
                                        Câu @cauHoi.ThuTu (Phần @((int)cauHoi.PhanThi))
                                    </h6>
                                    @if (!cauHoi.IsCorrect)
                                    {
                                        <span class="badge bg-danger">Sai</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Đúng</span>
                                    }
                                </div>

                                <div class="mb-3 fw-semibold" style="word-wrap: break-word; overflow-wrap: break-word; max-width: 100%; overflow-x: auto;">
                                    @Html.Raw(cauHoi.NoiDungCauHoi)
                                </div>

                                @* 👉 ĐÃ FIX LUỒNG IF-ELSE TRÁNH IN CODE RA MÀN HÌNH *@
                                @if (cauHoi.PhanThi == EnumLoaiPhanThi.TracNghiem)
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @{
                                            char prefix = 'A';
                                        }
                                        @foreach (var dapAn in cauHoi.DapAns.OrderBy(d => d.Id))
                                        {
                                            bool isStudentChoice = (cauHoi.DapAnHocVienChonId == dapAn.Id);
                                            bool isCorrect = dapAn.LaDapAnDung;

                                            string cssClass = "bg-white border";
                                            if (isCorrect) cssClass = "bg-success text-white border-success";
                                            else if (isStudentChoice && !isCorrect) cssClass = "bg-danger text-white border-danger";

                                            <div class="p-2 rounded @cssClass d-flex align-items-center" style="word-wrap: break-word; overflow-wrap: break-word; max-width: 100%; overflow-x: auto;">
                                                <input type="radio" disabled checked="@isStudentChoice" class="me-3">
                                                <span class="fw-bold me-2">@prefix.</span>
                                                <span>@Html.Raw(dapAn.NoiDung)</span>
                                            </div>
                                            prefix++;
                                        }
                                    </div>
                                }
                                else if (cauHoi.PhanThi == EnumLoaiPhanThi.MenhDeDungSai)
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @{
                                            char mdPrefix = 'a';
                                        }
                                        @foreach (var md in cauHoi.MenhDes)
                                        {
                                            bool isStudentCorrect = (md.LuaChonCuaHocVien == md.LaDung);

                                            <div class="p-2 bg-white border rounded d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                <div style="word-wrap: break-word; overflow-wrap: break-word; max-width: 100%; overflow-x: auto; flex: 1;">
                                                    <span class="fw-bold me-2">@mdPrefix)</span> @Html.Raw(md.NoiDung)
                                                </div>
                                                <div class="text-end" style="min-width: 150px;">
                                                    <span class="badge bg-secondary me-2">Đáp án: @(md.LaDung ? "Đúng" : "Sai")</span>
                                                    <span class="badge @(isStudentCorrect ? "bg-success" : "bg-danger")">
                                                        Bạn chọn: @(md.LuaChonCuaHocVien.HasValue ? (md.LuaChonCuaHocVien.Value ? "Đúng" : "Sai") : "Bỏ trống")
                                                    </span>
                                                </div>
                                            </div>
                                            mdPrefix++;
                                        }
                                    </div>
                                }
                                else if (cauHoi.PhanThi == EnumLoaiPhanThi.DienKetQua)
                                {
                                    <div class="p-3 bg-white border rounded d-flex gap-4 flex-wrap">
                                        <div>
                                            <div class="text-muted small">Bạn đã điền:</div>
                                            <div class="fw-bold fs-5 @(cauHoi.IsCorrect ? "text-success" : "text-danger")">
                                                @(cauHoi.GiaTriHocVienNhap?.ToString() ?? "Bỏ trống")
                                            </div>
                                        </div>
                                        <div class="border-start ps-4">
                                            <div class="text-muted small">Đáp án đúng:</div>
                                            <div class="fw-bold fs-5 text-success">@cauHoi.GiaTriDung</div>
                                            <div class="text-muted small" style="font-size: 0.75rem;">(Sai số cho phép: ±@cauHoi.SaiSoChoPhep)</div>
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(cauHoi.GiaiThich))
                                {
                                    <div class="mt-3 p-3 bg-white border border-info rounded">
                                        <h6 class="text-info fw-bold mb-2"><i class="fa-solid fa-lightbulb me-2"></i>Giải thích chi tiết:</h6>
                                        <div class="small" style="word-wrap: break-word; overflow-wrap: break-word; max-width: 100%; overflow-x: auto;">
                                            @Html.Raw(cauHoi.GiaiThich)
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>