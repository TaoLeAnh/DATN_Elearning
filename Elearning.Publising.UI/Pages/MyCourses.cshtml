@page "/khoa-hoc-cua-toi"
@model MyCoursesModel
@using System.ComponentModel
@using System.Reflection
@using Elearning.Shared.Contracts.Portal.Enums
@{
    ViewData["Title"] = "Khóa học của tôi";

    // --- HÀM ĐỌC DESCRIPTION CỦA ENUM ---
    string GetEnumDescription(Enum value)
    {
        FieldInfo fi = value.GetType().GetField(value.ToString());
        DescriptionAttribute[] attributes = (DescriptionAttribute[])fi.GetCustomAttributes(typeof(DescriptionAttribute), false);
        if (attributes != null && attributes.Length > 0)
            return attributes[0].Description;
        else
            return value.ToString();
    }

    // --- HÀM GÁN ICON ĐỘNG THEO MÔN HỌC ---
    string GetIcon(MonHocEnum m) => m switch
    {
        MonHocEnum.Toan => "🧮",
        MonHocEnum.NguVan => "📖",
        MonHocEnum.TiengAnh => "✍️",
        MonHocEnum.VatLy => "⚡",
        MonHocEnum.HoaHoc => "🧪",
        MonHocEnum.SinhHoc => "🧬",
        MonHocEnum.LichSu => "⏳",
        MonHocEnum.DiaLy => "🌍",
        MonHocEnum.GDCD => "🤝",
        MonHocEnum.KhoaHocVaDocHieu => "🔬",
        _ => "📚"
    };
}

<style>
    /* --- BÊ STYLE CỘT TRÁI TỪ TRANG KHÓA HỌC SANG --- */
    .subject-menu {
        display: flex;
        flex-direction: column;
        gap: 12px;
        position: sticky;
        top: 100px;
    }

    .subject-item {
        display: flex;
        align-items: center;
        padding: 12px 20px;
        background-color: #fcfcfc;
        border: 1.5px solid #eaeaea;
        border-radius: 14px;
        cursor: pointer;
        transition: all 0.2s ease;
        color: #1a365d;
        font-weight: 700;
    }

        .subject-item:hover, .subject-item.active {
            border-color: #0d6efd;
            background-color: #f0f7ff;
            color: #0d6efd;
        }

    .subject-icon {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #fff;
        border-radius: 10px;
        margin-right: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        font-size: 1.2rem;
    }

    /* --- STYLE CARD CỦA TRANG MY COURSES --- */
    .my-course-card {
        transition: all 0.3s ease;
        border: none;
        border-radius: 12px;
        overflow: hidden;
    }

        .my-course-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .progress {
        height: 8px;
        border-radius: 10px;
    }

    .course-img-wrapper {
        height: 160px;
        position: relative;
    }

    .btn-continue {
        background: linear-gradient(135deg, #0072bc 0%, #28b1ff 100%);
        border: none;
        color: white;
    }
</style>

<div class="container mt-5 mb-5" style="min-height: 70vh;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa-solid fa-book-bookmark text-primary me-2"></i> Khóa học của tôi</h2>

        <div class="d-flex gap-3">
            <div class="input-group shadow-sm" style="width: 250px; border-radius: 8px; overflow: hidden;">
                <span class="input-group-text bg-white border-0"><i class="fa-solid fa-search text-muted"></i></span>
                <input type="text" id="courseSearch" class="form-control border-0 border-start" placeholder="Tìm tên khóa học..." style="box-shadow: none;">
            </div>

            <select id="courseFilter" class="form-select border-0 shadow-sm" style="width: 180px; border-radius: 8px;">
                <option value="all">Tất cả trạng thái</option>
                <option value="learning">Đang học</option>
                <option value="completed">Đã hoàn thành</option>
            </select>
        </div>
    </div>

    @if (Model.LstMyCourses != null && Model.LstMyCourses.Any())
    {
        <div class="row g-4">
            <div class="col-lg-3">
                <div class="subject-menu custom-scrollbar" style="max-height: 70vh; overflow-y: auto;">
                    <div class="subject-item active" data-subject-value="all">
                        <div class="subject-icon"><i class="fa-solid fa-border-all"></i></div>
                        Tất cả môn học
                    </div>

                    @* VÒNG LẶP ĐỘNG ĐỌC TỪ ENUM *@
                    @foreach (MonHocEnum mon in Enum.GetValues(typeof(MonHocEnum)))
                    {
                        <div class="subject-item" data-subject-value="@((int)mon)">
                            <div class="subject-icon">@GetIcon(mon)</div>
                            @GetEnumDescription(mon)
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-9">
                <div class="row g-4" id="courseListContainer">
                    @foreach (var item in Model.LstMyCourses)
                    {
                        <div class="col-md-4 course-item" data-progress="@item.TienDo" data-subject="@((int)item.MonHoc)">
                            <div class="card h-100 my-course-card shadow-sm border border-light">
                                @* Ảnh khóa học *@
                                <div class="course-img-wrapper">
                                    <img src="@(item.HinhAnhUrl ?? "https://placehold.co/600x400?text=Course")" class="w-100 h-100" style="object-fit: cover;">
                                    @if (item.TienDo >= 100)
                                    {
                                        <span class="badge bg-success position-absolute top-0 end-0 m-2">Hoàn thành</span>
                                    }
                                </div>

                                <div class="card-body d-flex flex-column">
                                    <h6 class="fw-bold mb-1 course-title-text" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 45px;">
                                        @item.TenKhoaHoc
                                    </h6>
                                    <p class="text-muted small mb-3">GV: @item.TenGiangVien</p>

                                    @* Tiến độ *@
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between mb-1 small">
                                            <span>Tiến độ</span>
                                            <span class="fw-bold">@item.TienDo%</span>
                                        </div>
                                        <div class="progress mb-3">
                                            <div class="progress-bar @(item.TienDo >= 100 ? "bg-success" : "bg-primary")"
                                                 role="progressbar" style="width: @item.TienDo%"></div>
                                        </div>
                                        @{
                                            string linkHoc = $"/Study?courseId={item.Id}";
                                            if (item.BaiHocCuoiCungId.HasValue && item.BaiHocCuoiCungId.Value != Guid.Empty)
                                            {
                                                linkHoc += $"&lessonId={item.BaiHocCuoiCungId.Value}";
                                            }
                                        }
                                        <a href="@linkHoc" class="btn btn-continue w-100 fw-bold rounded-pill">
                                            @(item.TienDo > 0 ? "HỌC TIẾP" : "BẮT ĐẦU HỌC")
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div id="noResultMsg" class="text-center py-5" style="display: none;">
                    <i class="fa-solid fa-ghost fa-3x text-muted opacity-50 mb-3"></i>
                    <h5 class="text-muted">Không tìm thấy khóa học nào phù hợp.</h5>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" style="width: 150px; opacity: 0.5;" />
            <h4 class="mt-4 text-muted">Bạn chưa đăng ký khóa học nào</h4>
            <a href="/danh-sach-khoa-hoc" class="btn btn-primary mt-3 px-4 rounded-pill">Khám phá ngay</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const filterSelect = document.getElementById('courseFilter');
            const searchInput = document.getElementById('courseSearch');
            const courseItems = document.querySelectorAll('.course-item');
            const subjectItems = document.querySelectorAll('.subject-item');
            const noResultMsg = document.getElementById('noResultMsg');

            let currentSubjectFilter = 'all';

            function applyFilters() {
                const statusValue = filterSelect ? filterSelect.value : 'all';
                const searchValue = searchInput ? searchInput.value.toLowerCase().trim() : '';
                let visibleCount = 0;

                courseItems.forEach(item => {
                    const progress = parseFloat(item.getAttribute('data-progress')) || 0;
                    const courseSubject = item.getAttribute('data-subject');
                    const courseName = item.querySelector('.course-title-text').innerText.toLowerCase();

                    // 1. Trạng thái
                    let matchStatus = false;
                    if (statusValue === 'all') matchStatus = true;
                    else if (statusValue === 'learning' && progress < 100) matchStatus = true;
                    else if (statusValue === 'completed' && progress >= 100) matchStatus = true;

                    // 2. Tìm kiếm
                    let matchSearch = courseName.includes(searchValue);

                    // 3. Môn học
                    let matchSubject = false;
                    if (currentSubjectFilter === 'all' || currentSubjectFilter === courseSubject) matchSubject = true;

                    // Gộp điều kiện
                    if (matchStatus && matchSearch && matchSubject) {
                        item.style.display = 'block';
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                if(noResultMsg) {
                    noResultMsg.style.display = visibleCount === 0 ? 'block' : 'none';
                }
            }

            subjectItems.forEach(item => {
                item.addEventListener('click', function () {
                    subjectItems.forEach(i => i.classList.remove('active'));
                    this.classList.add('active');
                    currentSubjectFilter = this.getAttribute('data-subject-value');
                    applyFilters();
                });
            });

            if (filterSelect) filterSelect.addEventListener('change', applyFilters);
            if (searchInput) searchInput.addEventListener('keyup', applyFilters);
        });
    </script>
}