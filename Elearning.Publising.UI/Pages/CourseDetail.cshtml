@page
@model CourseDetailModel
@{
    ViewData["Title"] = Model.KhoaHocDetail?.TenKhoaHoc ?? "Chi tiết khóa học";
}

@if (Model.KhoaHocDetail != null)
{
    <div class="container mt-4 mb-5">
        <div class="row g-4">

            <div class="col-lg-8">
                <ul class="nav nav-tabs course-nav-tabs mb-4" id="courseTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">THÔNG TIN KHÓA HỌC</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="syllabus-tab" data-bs-toggle="tab" data-bs-target="#syllabus" type="button" role="tab">CHƯƠNG TRÌNH HỌC</button>
                    </li>
                </ul>

                <div class="tab-content" id="courseTabContent">

                    <div class="tab-pane fade" id="info" role="tabpanel">
                        <div class="card border-0 shadow-sm p-4">
                            <h4 class="fw-bold mb-3">Giới thiệu khóa học</h4>
                            <p style="white-space: pre-line;">
                                @(string.IsNullOrEmpty(Model.KhoaHocDetail.MoTa) ? "Đang cập nhật thông tin..." : Model.KhoaHocDetail.MoTa)
                            </p>
                        </div>
                    </div>

                    <div class="tab-pane fade show active" id="syllabus" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="fw-bold m-0">Chương trình học</h4>
                            <div class="input-group" style="max-width: 250px;">
                                <input type="text" class="form-control" placeholder="Tìm bài học...">
                                <button class="btn btn-outline-secondary" type="button"><i class="fa-solid fa-search"></i></button>
                            </div>
                        </div>

                        <div class="accordion chapter-accordion" id="accordionSyllabus">
                            @if (Model.KhoaHocDetail.ChuongHocs != null && Model.KhoaHocDetail.ChuongHocs.Any())
                            {
                                int chuongIndex = 0;
                                foreach (var chuong in Model.KhoaHocDetail.ChuongHocs)
                                {
                                    chuongIndex++;
                                    string targetId = $"chapter_{chuong.Id}";
                                    bool isFirst = chuongIndex == 1;

                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button @(isFirst ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@targetId">
                                                Chương @chuongIndex: @chuong.TenChuong
                                            </button>
                                        </h2>
                                        <div id="@targetId" class="accordion-collapse collapse @(isFirst ? "show" : "")">
                                            <div class="accordion-body">

                                                @if (chuong.BaiHocs != null && chuong.BaiHocs.Any())
                                                {
                                                    <div class="timeline-container mt-2">
                                                        @foreach (var bai in chuong.BaiHocs)
                                                        {
                                                            // 1. HIỂN THỊ BÀI HỌC (VIDEO/DOC)
                                                            <a href="/Study?courseId=@Model.KhoaHocDetail.Id&lessonId=@bai.Id"
                                                               class="lesson-box d-flex justify-content-between align-items-center text-decoration-none text-dark">
                                                                <div>
                                                                    <i class="fa-solid fa-play-circle lesson-icon text-primary me-2"></i>
                                                                    <span class="fw-bold">@bai.TieuDe</span>
                                                                </div>
                                                                <div class="d-flex align-items-center">
                                                                    <span class="text-muted small me-3">@bai.ThoiLuong phút</span>
                                                                    <i class="fa-solid fa-arrow-right arrow-icon"></i>
                                                                </div>
                                                            </a>

                                                            // 2. HIỂN THỊ BỘ CÂU HỎI CỦA BÀI HỌC NÀY
                                                            @if (bai.DanhSachBoCauHoi != null && bai.DanhSachBoCauHoi.Any())
                                                            {
                                                                foreach (var quiz in bai.DanhSachBoCauHoi)
                                                                {
                                                                    <a href="/Study?courseId=@Model.KhoaHocDetail.Id&quizId=@quiz.Id"
                                                                       class="lesson-box ms-4 bg-light d-flex justify-content-between align-items-center text-decoration-none text-dark" style="border-left: 3px solid #ff9800;">
                                                                        <div>
                                                                            <i class="fa-solid fa-clipboard-question text-warning me-2"></i>
                                                                            <span>Bài tập: @quiz.TenBo</span>
                                                                        </div>
                                                                        <div class="d-flex align-items-center">
                                                                            <span class="text-muted small me-3">Thực hành</span>
                                                                            <i class="fa-solid fa-arrow-right arrow-icon text-muted"></i>
                                                                        </div>
                                                                    </a>
                                                                }
                                                            }
                                                        }

                                                        @if (chuong.DanhSachBoCauHoi != null && chuong.DanhSachBoCauHoi.Any())
                                                        {
                                                            <hr class="my-2" />
                                                            foreach (var quiz in chuong.DanhSachBoCauHoi)
                                                            {
                                                                <a href="/Study?courseId=@Model.KhoaHocDetail.Id&quizId=@quiz.Id"
                                                                   class="lesson-box d-flex justify-content-between align-items-center text-decoration-none text-dark" style="background-color: #fff3cd; border: 1px dashed #ffe69c;">
                                                                    <div>
                                                                        <i class="fa-solid fa-list-check text-danger me-2"></i>
                                                                        <span class="fw-bold text-danger">Ôn tập chương: @quiz.TenBo</span>
                                                                    </div>
                                                                    <div class="d-flex align-items-center">
                                                                        <span class="text-danger small me-3">Kiểm tra</span>
                                                                        <i class="fa-solid fa-arrow-right arrow-icon text-danger"></i>
                                                                    </div>
                                                                </a>
                                                            }
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted fst-italic">Chương này chưa có bài học.</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center p-4 border rounded bg-light text-muted">
                                    <i class="fa-solid fa-box-open fa-2x mb-2"></i>
                                    <p class="mb-0">Khóa học này đang được cập nhật nội dung.</p>
                                </div>
                            }
                        </div>

                        @if (Model.KhoaHocDetail.DanhSachBoCauHoi != null && Model.KhoaHocDetail.DanhSachBoCauHoi.Any())
                        {
                            <div class="mt-4 p-4 rounded" style="background-color: #f8d7da;">
                                <h5 class="fw-bold text-danger mb-3"><i class="fa-solid fa-graduation-cap me-2"></i> Kiểm tra cuối khóa</h5>
                                @foreach (var quiz in Model.KhoaHocDetail.DanhSachBoCauHoi)
                                {
                                    <a href="/Study?courseId=@Model.KhoaHocDetail.Id&quizId=@quiz.Id"
                                       class="lesson-box bg-white d-flex justify-content-between align-items-center text-decoration-none text-dark mb-2 shadow-sm">
                                        <div>
                                            <i class="fa-solid fa-file-signature text-danger me-2"></i>
                                            <span class="fw-bold">@quiz.TenBo</span>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <button class="btn btn-sm btn-danger rounded-pill px-3 me-3">Làm bài</button>
                                            <i class="fa-solid fa-arrow-right arrow-icon text-danger"></i>
                                        </div>
                                    </a>
                                }
                            </div>
                        }

                    </div>
                </div>

                <div class="card border-0 shadow-sm mt-4 p-4">
                    <h5 class="fw-bold">Đánh giá khóa học</h5>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <div class="text-warning fs-5">
                            <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                        </div>
                        <span class="text-muted">(Chưa có đánh giá)</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="course-sidebar-sticky">

                    @* 1. KHU VỰC HIỂN THỊ THÔNG BÁO (Fix lỗi hộp đỏ bị trống) *@
                    @if (TempData["ErrorMessage"] != null && !string.IsNullOrWhiteSpace(TempData["ErrorMessage"].ToString()))
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["SuccessMessage"] != null && !string.IsNullOrWhiteSpace(TempData["SuccessMessage"].ToString()))
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @* 2. ẢNH KHÓA HỌC *@
                    <div class="rounded overflow-hidden mb-3 shadow-sm" style="background-color: #f0f0f0;">
                        @{
                            string imgUrl = !string.IsNullOrEmpty(Model.KhoaHocDetail.HinhAnhUrl)
                            ? Model.KhoaHocDetail.HinhAnhUrl
                            : "https://placehold.co/600x350/0072bc/FFF?text=HOCMAI+Course";
                        }
                        <img src="@imgUrl" class="w-100" style="aspect-ratio: 16/9; object-fit: cover;" alt="Cover">
                    </div>

                    <div class="course-price-box">
                        @* 3. GIÁ TIỀN *@
                        <div class="text-center mb-3">
                            <div class="d-flex justify-content-center align-items-end gap-2">
                                @if (Model.KhoaHocDetail.GiaBan.HasValue && Model.KhoaHocDetail.GiaBan > 0)
                                {
                                    <span class="price-sale text-danger fw-bold fs-3">@Model.KhoaHocDetail.GiaBan.Value.ToString("N0") ₫</span>
                                }
                                else
                                {
                                    <span class="price-sale text-success fw-bold fs-3">Miễn phí</span>
                                }
                            </div>

                            @if (Model.KhoaHocDetail.GiaGoc.HasValue && Model.KhoaHocDetail.GiaGoc > Model.KhoaHocDetail.GiaBan)
                            {
                                <div class="price-original mt-1 text-muted text-decoration-line-through">@Model.KhoaHocDetail.GiaGoc.Value.ToString("N0") ₫</div>
                            }
                        </div>

                        @* 4. FORM NÚT ĐĂNG KÝ *@
                        <form method="post" asp-page-handler="Register">
                            <input type="hidden" name="courseId" value="@Model.KhoaHocDetail.Id" />
                            <div class="d-grid gap-2 mt-4">
                                <button type="submit" class="btn btn-orange-fill py-2 rounded-pill shadow-sm text-white fw-bold" style="background-color: #ff6a00;">
                                    <i class="fa-solid fa-user-edit me-2"></i> ĐĂNG KÝ HỌC
                                </button>
                            </div>
                        </form>

                        <hr class="my-4">

                        @* 5. THỐNG KÊ *@
                        <div class="small text-muted" style="line-height: 1.6;">
                            <p class="mb-2 text-dark"><strong>@Model.KhoaHocDetail.TenKhoaHoc</strong></p>
                            @if (!string.IsNullOrEmpty(Model.KhoaHocDetail.TenGiangVien))
                            {
                                <p class="mb-1"><i class="fa-solid fa-chalkboard-user me-2"></i> Giảng viên: <strong>@Model.KhoaHocDetail.TenGiangVien</strong></p>
                            }
                            <p class="mb-0"><i class="fa-solid fa-book-open me-2"></i> Tổng số: <strong>@Model.KhoaHocDetail.ChuongHocs.Sum(c => c.BaiHocs.Count) bài học</strong></p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
}
else
{
    <div class="container mt-5 mb-5 text-center">
        <i class="fa-solid fa-triangle-exclamation fa-3x text-warning mb-3"></i>
        <h4>Không tìm thấy khóa học</h4>
        <p class="text-muted">Khóa học này không tồn tại hoặc đã bị ẩn.</p>
        <a href="/" class="btn btn-primary">Về trang chủ</a>
    </div>
}